# Сборка frontend для стенда: статика в nginx, /api проксируется в backend.
# Для разработки остаётся Dockerfile с Vite — его запускает compose.yaml.
#
#   docker build -f frontend/Dockerfile.prod -t repo-health-frontend frontend
#   docker run -p 80:8080 -e API_PROXY_TARGET=http://backend:8000 repo-health-frontend
#
# Базовые образы закреплены SHA-256 digest, как в остальных Dockerfile проекта
# (docs/ci-security.md): tag объясняет, что это за образ, digest фиксирует его байты.
# Обновление — новым digest из `docker buildx imagetools inspect <образ:tag>`.

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# auto — настоящий API, а для разделов, которых у backend ещё нет, демо с пометкой.
# api — только настоящий API; demo — только демо, backend не нужен.
ARG VITE_DATA_SOURCE=auto
ENV VITE_DATA_SOURCE=${VITE_DATA_SOURCE}
RUN npm run build

# Как и остальные контейнеры проекта, nginx работает не от root: официальный образ
# nginx-unprivileged запускается пользователем nginx (uid 101) и слушает порт 8080.
# 1.30 — текущая stable-ветка nginx; 1.27 больше не обновляется (последний образ — июнь 2025).
FROM nginxinc/nginx-unprivileged:1.30-alpine@sha256:4714e0b1b2577eaa1a6131d07c958b67f0eb68e6d0521e90c6e5287db8cf0bc5

# Куда проксировать /api и чем резолвить его имя. 127.0.0.11 — встроенный DNS Docker:
# имя backend резолвится на каждый запрос, поэтому перезапуск backend не ломает proxy.
ENV API_PROXY_TARGET=http://backend:8000 \
    NGINX_RESOLVER=127.0.0.11

# Образ nginx при старте подставляет переменные окружения в шаблоны из /etc/nginx/templates.
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/healthz || exit 1
