# Приложение
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Порт браузерного HMR клиента при работе за HTTPS-прокси (например, 443)
VITE_HMR_CLIENT_PORT=

# Инфраструктура
DATABASE_URL=postgresql+asyncpg://repo_health:repo_health@postgres:5432/repo_health
REDIS_URL=redis://redis:6379/0

# Интеграции
# Настоящие секреты храните только в локальном .env или в хранилище секретов среды развёртывания.
# Включайте вход, только когда обе первые переменные заполнены и redirect URI
# зарегистрирован в приложении Яндекс ID. Для локального Docker: http://localhost:5173/api/v1/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_REDIRECT_URI=
YANDEX_CLIENT_SECRET=
YANDEX_SESSION_COOKIE_SECURE=false

# Включает личное подключение SourceCraft. Это ключ Fernet, а не PAT:
# один раз создайте его локально командой
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Не коммитьте значение и не передавайте его в браузер. Без ключа endpoint
# подключения намеренно отключён, а private/internal данные не читаются.
SOURCECRAFT_CONNECTION_ENCRYPTION_KEY=

# Public-only production-анализ использует один из двух режимов: глобальное
# обнаружение открытых репозиториев или allowlist организаций через запятую.
# Не включайте оба режима одновременно; private/internal всегда отклоняются.
SOURCECRAFT_TOKEN=
SOURCECRAFT_DISCOVER_PUBLIC_REPOSITORIES=false
SOURCECRAFT_PUBLIC_ORGANIZATIONS=

# Периодически пересчитывает только public-репозитории из выбранного каталога.
# Включайте после применения миграций PostgreSQL; без true планировщик выключен.
PUBLIC_ANALYSIS_SCHEDULER_ENABLED=false

# Необязательный безопасный bridge AppSec. Локальный exporter создаёт в этом
# каталоге только агрегаты severity/status/count; backend читает каталог через
# отдельный read-only Docker mount. GID должен совпадать с --reader-gid exporter.
SOURCECRAFT_APPSEC_SNAPSHOT_HOST_DIR=./.local/sourcecraft-appsec-snapshots
SOURCECRAFT_APPSEC_SNAPSHOT_READER_GID=10001
SOURCECRAFT_APPSEC_SNAPSHOT_MAX_AGE_SECONDS=3600

# Лимиты ресурсов и анализа крупных репозиториев (ТЗ §9.2)
# Значения по умолчанию рассчитаны на работу с репозиториями масштаба >= 500 МБ,
# >= 20 000 коммитов и >= 10 000 файлов. При необходимости переопределите в .env.
# SOURCECRAFT_GIT_TIMEOUT_SECONDS=120.0
# SOURCECRAFT_MAX_GIT_FILES=50000
# SOURCECRAFT_MAX_GIT_BLOB_BYTES=52428800
# SOURCECRAFT_MAX_GIT_TREE_BYTES=629145600
# SOURCECRAFT_MAX_GIT_CHECKOUT_BYTES=786432000
# SOURCECRAFT_COMMIT_HISTORY_LIMIT=50000
# SOURCECRAFT_COMMIT_HISTORY_TIMEOUT_SECONDS=120.0
# SOURCECRAFT_CODE_HEALTH_MAX_FILES=50000
# SOURCECRAFT_CODE_HEALTH_MAX_BYTES=104857600
# SOURCECRAFT_CODE_HEALTH_MAX_FILE_READ_BYTES=5242880

# AI-рекомендации (Yandex AI Studio Foundation Models).
# Без ключа AI отключён — детерминированные рекомендации работают как обычно.
# Ключ создаётся в https://console.yandex.cloud/ → AI Studio → API-ключи.
YANDEX_AI_STUDIO_API_KEY=
YANDEX_AI_MODEL=yandexgpt-lite:latest
# YANDEX_AI_TIMEOUT_SECONDS=15
